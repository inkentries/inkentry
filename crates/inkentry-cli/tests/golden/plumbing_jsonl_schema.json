{
  "$comment": [
    "Golden schema for the plumbing JSONL stability contract (docs/stability.md).",
    "Field presence and type only, never values. `required` fields appear on every",
    "emitted line; `optional` fields may be omitted but must match their type when",
    "present. Undeclared fields are accepted: v1 evolution is additive-only.",
    "Adding a field here without shipping it fails the conformance tests; removing,",
    "renaming, or retyping a field in the code fails them too. That is the point.",
    "Type spellings: string, integer, number, boolean, object, null, any,",
    "array<T>, and `|` unions such as string|null."
  ],
  "commands": {
    "cat-chunks": {
      "$comment": "inkentry_core::search::SearchResult, via Database::chunks_for_file.",
      "required": {
        "chunk_id": "integer",
        "file_path": "string",
        "language": "string",
        "node_type": "string",
        "name": "string|null",
        "start_line": "integer",
        "end_line": "integer",
        "content": "string",
        "distance": "number",
        "from_graph": "boolean",
        "governing_specs": "array<string>",
        "token_count": "integer",
        "project_name": "string|null",
        "project_path": "string|null",
        "summary": "string|null"
      }
    },
    "ls-files": {
      "required": {
        "path": "string",
        "language": "string|null",
        "chunk_count": "integer",
        "indexed_at": "integer|null",
        "stale": "boolean"
      }
    },
    "parse-file": {
      "required": {
        "kind": "string",
        "name": "string|null",
        "start_line": "integer",
        "end_line": "integer",
        "content": "string",
        "language": "string"
      }
    },
    "hash-file": {
      "required": {
        "path": "string",
        "hash": "string",
        "indexed_hash": "string|null",
        "is_current": "boolean"
      }
    },
    "knn": {
      "$comment": "SearchResult with `score` (1 - distance) spliced in at the JSON level.",
      "required": {
        "chunk_id": "integer",
        "file_path": "string",
        "language": "string",
        "node_type": "string",
        "name": "string|null",
        "start_line": "integer",
        "end_line": "integer",
        "content": "string",
        "distance": "number",
        "score": "number",
        "from_graph": "boolean",
        "governing_specs": "array<string>",
        "token_count": "integer",
        "project_name": "string|null",
        "project_path": "string|null",
        "summary": "string|null"
      }
    },
    "embed": {
      "required": {
        "model": "string",
        "dimensions": "integer",
        "vector": "array<number>"
      }
    },
    "graph-edges": {
      "required": {
        "source_file": "string",
        "source_name": "string|null",
        "target_name": "string",
        "kind": "string",
        "line": "integer"
      }
    },
    "read-memory": {
      "$comment": "inkentry_core::storage::memory::Note. The optional fields carry serde skip_serializing_if.",
      "required": {
        "id": "string",
        "kind": "string",
        "title": "string",
        "body": "string",
        "tags": "array<string>",
        "linked_files": "array<string>",
        "created_at": "integer",
        "status": "string"
      },
      "optional": {
        "superseded_by": "string",
        "source_ref": "string",
        "valid_at": "integer",
        "invalid_at": "integer",
        "distance": "number",
        "score": "number",
        "source_project": "string",
        "source_project_path": "string",
        "remote_id": "string"
      }
    },
    "publish-notes": {
      "$comment": "Three outcome shapes share published+remote; the rest are outcome-specific.",
      "required": {
        "published": "boolean",
        "remote": "string"
      },
      "optional": {
        "ref": "string",
        "attempts": "integer",
        "skipped": "string",
        "error": "string"
      }
    },
    "push": {
      "$comment": "One report object per completed run (exit 0 or 1); drawn from PushSummary. A run that did not complete exits 2 with no report. `interrupted` is therefore always false in an emitted report; it is declared so the field stays part of the contract.",
      "required": {
        "attempted": "integer",
        "created": "integer",
        "skipped": "integer",
        "failed": "integer",
        "already_synced": "integer",
        "edges_pushed": "integer",
        "without_local_vector": "integer",
        "embedded_locally": "integer",
        "interrupted": "boolean"
      }
    },
    "pull": {
      "$comment": "One report object per completed run (exit 0 or 1). The two embed counts mirror `push`'s: `embedded_locally` is the missing local vectors this run minted for synced rows, `without_local_vector` the synced rows still waiting on one.",
      "required": {
        "applied": "integer",
        "embedded_locally": "integer",
        "without_local_vector": "integer"
      }
    }
  }
}
