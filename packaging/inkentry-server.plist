<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for inkentry-server.

  To install and load:
    cp packaging/inkentry-server.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/inkentry-server.plist

  To unload:
    launchctl unload ~/Library/LaunchAgents/inkentry-server.plist
    rm ~/Library/LaunchAgents/inkentry-server.plist

  Upgrading from a build whose Label was cloud.spelunk.server: unload before
  replacing the file. `launchctl unload` reads the Label out of the file it is
  given, so replacing it first leaves the old job running under the old Label.
    launchctl remove cloud.spelunk.server
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.inkentry.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/inkentry-server</string>
        <string>--port</string>
        <string>4655</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/inkentry-server.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/inkentry-server.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
