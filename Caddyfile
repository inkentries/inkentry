# Caddyfile for the `proxy` sidecar in docker-compose.yml.
#
# Terminates TLS on :8443 and forwards plaintext to spelunk-server on
# 127.0.0.1:7777. The proxy shares spelunk-server's network namespace
# (`network_mode: "service:spelunk-server"` in docker-compose.yml), so
# "127.0.0.1" here means the spelunk-server container, not the proxy
# container itself — that's what lets spelunk-server stay bound to loopback
# (satisfying its own keyed-non-loopback-plaintext refusal, see
# docs/server.md#trust-model) while still being reachable off-host.
#
# Default: `tls internal` — Caddy mints its own local CA and a self-signed
# leaf cert for whatever hostname the client used to connect, with no
# external cert authority and no config. Fine for getting a keyed server
# reachable off-host quickly; clients must either trust Caddy's local CA
# (see `docker compose exec proxy cat /data/caddy/pki/authorities/local/root.crt`)
# or connect with cert verification disabled (`curl -k`, or spelunk's
# equivalent) — do not do that over an untrusted network.
#
# For a real certificate instead (recommended for anything beyond a quick
# eval), replace the `tls internal` line with your domain and Caddy will
# fetch a Let's Encrypt certificate automatically — see docs/self-hosting.md.
:8443 {
	tls internal

	reverse_proxy 127.0.0.1:7777 {
		# The memory stream endpoint is Server-Sent Events — don't buffer it.
		flush_interval -1
	}
}
